class BankAccount
{
    public string Owner;
    public double Balance;

    public void Deposit(double amount)
    {
        if (amount > 0)
        {
            Balance += amount;
            Console.WriteLine("Пополнение: " + amount);
        }
    }

    public void Withdraw(double amount)
    {
        if (amount <= 0)
            return;

        if (amount <= Balance)
        {
            Balance -= amount;
            Console.WriteLine("Снятие: " + amount);
        }
        else
        {
            Console.WriteLine("Недостаточно средств.");
        }
    }

    public void TransferTo(BankAccount target, double amount)
    {
        if (amount <= 0)
            return;

        if (amount <= Balance)
        {
            Balance -= amount;
            target.Balance += amount;

            Console.WriteLine(
                "Перевод " + amount +
                " от " + Owner +
                " к " + target.Owner
            );
        }
        else
        {
            Console.WriteLine("Недостаточно средств.");
        }
    }

    public void ShowBalance()
    {
        Console.WriteLine(
            "Владелец: " + Owner +
            ", баланс: " + Balance
        );
    }
}


