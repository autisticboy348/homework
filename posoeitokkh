                    DeleteTask();
                    break;

                case "7":
                    ShowStatistics();
                    break;

                case "8":
                    FullTodoManager();
                    break;

                case "9":
                    Categories();
                    break;

                case "10":
                    SortTasks();
                    break;

                case "0":
                    return;

                default:
                    Console.WriteLine("Неверный выбор.");
                    break;
            }

            Pause();
            Console.Clear();
        }
    }

    static void AddTask()
    {
        Console.Write("Введите название задачи: ");
        string title = Console.ReadLine();

        TodoTask task = new TodoTask();

        task.Title = title;
        task.IsCompleted = false;

        tasks.Add(task);

        Console.WriteLine("Задача добавлена.");
    }

    static void ShowTasks()
    {
        if (tasks.Count == 0)
        {
            Console.WriteLine("Список задач пуст.");
            return;
        }

        Console.WriteLine("СПИСОК ЗАДАЧ:");
        Console.WriteLine();

        for (int i = 0; i < tasks.Count; i++)
        {
            string status =
                tasks[i].IsCompleted
                    ? "[X]"
                    : "[ ]";

            Console.WriteLine(
                (i + 1) + ". " +
                status + " " +
                tasks[i].Title
            );
        }
    }

    static void CompleteTask()
    {
        if (tasks.Count == 0)
        {
            Console.WriteLine("Список задач пуст.");
            return;
        }

        ShowTasks();

        Console.Write("Номер выполненной задачи: ");
        int number = int.Parse(Console.ReadLine());

        if (number < 1 || number > tasks.Count)
        {
            Console.WriteLine("Неверный номер.");
            return;
        }

        tasks[number - 1].IsCompleted = true;

        Console.WriteLine("Задача выполнена.");
    }

    static void SaveTasks()
    {
        List<string> lines = new List<string>();

        foreach (TodoTask task in tasks)
        {
            string line =
                task.Title +
                "|" +
                task.IsCompleted;

            lines.Add(line);
        }

        File.WriteAllLines(FileName, lines);

        Console.WriteLine(
            "Задачи сохранены в " + FileName
        );
    }

    // Задание 5
    static void LoadTasks()
    {
        if (!File.Exists(FileName))
        {
            Console.WriteLine("Файл задач не найден.");
            return;
        }

        tasks.Clear();

        string[] lines =
            File.ReadAllLines(FileName);

        foreach (string line in lines)
        {
            string[] parts = line.Split('|');

            if (parts.Length >= 2)
            {
                TodoTask task = new TodoTask();

                task.Title = parts[0];
                task.IsCompleted =
                    bool.Parse(parts[1]);

                tasks.Add(task);
            }
        }

        Console.WriteLine(
            "Загружено задач: " + tasks.Count
        );
    }

    static void DeleteTask()
    {
        if (tasks.Count == 0)
        {
            Console.WriteLine("Список задач пуст.");
            return;
        }

        ShowTasks();

        Console.Write("Номер задачи для удаления: ");
        int number = int.Parse(Console.ReadLine());

        if (number < 1 || number > tasks.Count)
        {
            Console.WriteLine("Неверный номер.");
            return;
        }

        tasks.RemoveAt(number - 1);

        Console.WriteLine("Задача удалена.");
    }

    static void ShowStatistics()
    {
